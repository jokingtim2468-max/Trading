//@version=6
// ES/NQ paper-test indicator: Opening Range Breakout + Opening Gap Fill.
// UNVALIDATED: both setups failed the walk-forward study in research/REPORT.md
// (test PF: ORB 0.76 ES / 0.93 NQ, Gap 0.98 ES / 1.14 NQ). Paper trade only.
// Use on a 5-minute ES1!/NQ1!/MES1!/MNQ1! chart. Sizing is in MICROS (MES $5/pt, MNQ $2/pt).
indicator("ES/NQ Paper Test - ORB + Gap Fill [UNVALIDATED]", shorttitle = "ORB+GAP paper", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────── inputs
grpS = "Setups"
mode      = input.string("Both", "Setups", options = ["ORB", "Gap Fill", "Both"], group = grpS)
orMin     = input.int(15, "ORB: opening range minutes", minval = 5, step = 5, group = grpS)
orTpR     = input.float(2.0, "ORB: target (R multiple)", minval = 0.5, step = 0.25, group = grpS)
orEndHHMM = input.int(1130, "ORB: last signal time ET (HHMM)", group = grpS)
gapMin    = input.float(0.15, "Gap: min gap %", step = 0.05, group = grpS)
gapMax    = input.float(1.0, "Gap: max gap %", step = 0.05, group = grpS)
gapMinRR  = input.float(1.0, "Gap: min reward/risk to prior close", step = 0.25, group = grpS)

grpR = "Lucid 25K rules"
riskUsd    = input.float(150, "Risk per trade $", group = grpR)
maxMicros  = input.int(20, "Max micros", group = grpR)
maxLosses  = input.int(2, "Max losing trades per day", group = grpR)
maxDayLoss = input.float(400, "Max daily loss $", group = grpR)
maxHold    = input.int(60, "Max minutes in a trade", group = grpR)
commRT     = input.float(1.24, "Commission $ per micro (round trip)", group = grpR)
slipTicks  = input.int(1, "Slippage ticks per market fill", group = grpR)

grpN = "News blackout"
useFomc   = input.bool(true, "FOMC days (14:00 ET): no entries 13:30-15:00", group = grpN)
useIsm    = input.bool(true, "ISM (10:00 ET, 1st & 3rd trading day of month)", group = grpN)
extraNews = input.string("", "Extra news: YYYY-MM-DD HH:MM, comma separated", group = grpN)

// ───────────────────────── constants
tz     = "America/New_York"
var fomc = array.from("2020-12-16", "2021-01-27", "2021-03-17", "2021-04-28", "2021-06-16", "2021-07-28", "2021-09-22", "2021-11-03", "2021-12-15",
     "2022-01-26", "2022-03-16", "2022-05-04", "2022-06-15", "2022-07-27", "2022-09-21", "2022-11-02", "2022-12-14",
     "2023-02-01", "2023-03-22", "2023-05-03", "2023-06-14", "2023-07-26", "2023-09-20", "2023-11-01", "2023-12-13",
     "2024-01-31", "2024-03-20", "2024-05-01", "2024-06-12", "2024-07-31", "2024-09-18", "2024-11-07", "2024-12-18",
     "2025-01-29", "2025-03-19", "2025-05-07", "2025-06-18", "2025-07-30", "2025-09-17", "2025-10-29", "2025-12-10",
     "2026-01-28", "2026-03-18", "2026-04-29", "2026-06-17", "2026-07-29", "2026-09-16", "2026-10-28", "2026-12-09",
     "2027-01-27", "2027-03-17", "2027-04-28", "2027-06-09", "2027-07-28", "2027-09-15", "2027-10-27", "2027-12-08")
root   = syminfo.root
pv     = root == "ES" or root == "MES" ? 5.0 : root == "NQ" or root == "MNQ" ? 2.0 : syminfo.pointvalue
tick   = syminfo.mintick
tfMin  = int(timeframe.in_seconds() / 60)
etMin  = hour(time, tz) * 60 + minute(time, tz)   // bar open, minutes from midnight ET
clMin  = etMin + tfMin                              // bar close
today  = str.format_time(time, "yyyy-MM-dd", tz)
orEnd  = int(math.floor(orEndHHMM / 100)) * 60 + orEndHHMM % 100
isOpenBar = etMin == 570

// ───────────────────────── day state
var int   tdom = 0
var int   lastMonth = -1
var float orh = na
var float orl = na
var float pdc = na
var float rthCloseToday = na
var bool  orbDone = false
var float dayPnl = 0.0
var int   dayLosses = 0
var bool  isFomc = false
var array<int> evMins = array.new<int>()

if isOpenBar
    m = month(time, tz)
    tdom := m != lastMonth ? 1 : tdom + 1
    lastMonth := m
    pdc := rthCloseToday
    orh := high
    orl := low
    orbDone := false
    dayPnl := 0.0
    dayLosses := 0
    isFomc := useFomc and array.includes(fomc, today)
    array.clear(evMins)
    if useIsm and (tdom == 1 or tdom == 3)
        array.push(evMins, 600)
    if str.length(extraNews) > 0
        for p in str.split(extraNews, ",")
            s = str.trim(p)
            if str.length(s) >= 16 and str.substring(s, 0, 10) == today
                array.push(evMins, int(str.tonumber(str.substring(s, 11, 13)) * 60 + str.tonumber(str.substring(s, 14, 16))))
else if etMin > 570 and etMin < 570 + orMin
    orh := math.max(orh, high)
    orl := math.min(orl, low)
if etMin < 960 and clMin >= 960
    rthCloseToday := close

inBlackout(int t) =>
    bool b = false
    for e in evMins
        if t >= e - 15 and t < e + 5
            b := true
    if isFomc and t >= 810 and t < 900
        b := true
    b

mustFlatten(int closeT, int entryT) =>
    bool f = false
    for e in evMins
        if closeT >= e - 5 and entryT < e
            f := true
    if isFomc and closeT >= 835 and entryT < 840
        f := true
    f

sizeFor(float e, float sl) =>
    rpm = (math.abs(e - sl) + 2 * slipTicks * tick) * pv + commRT
    math.min(maxMicros, math.floor(riskUsd / rpm))

locked = dayLosses >= maxLosses or dayPnl <= -maxDayLoss

// ───────────────────────── virtual position (tracks outcomes for the daily lock)
var int   pos = 0
var float ePx = na
var float sPx = na
var float tPx = na
var int   eMin = 0
var int   eQty = 0
var int   eBar = 0

if barstate.isconfirmed and pos != 0 and bar_index > eBar
    hitS = pos > 0 ? low <= sPx : high >= sPx
    hitT = pos > 0 ? high >= tPx + tick : low <= tPx - tick
    float xPx = na
    string why = ""
    if hitS
        xPx := sPx - pos * slipTicks * tick
        why := "SL"
    else if hitT
        xPx := tPx
        why := "TP"
    else if clMin - eMin >= maxHold or clMin >= 955 or mustFlatten(clMin, eMin)
        xPx := close - pos * slipTicks * tick
        why := "Time/EOD/News"
    if not na(xPx)
        pnl = pos * (xPx - ePx) * pv * eQty - commRT * eQty
        dayPnl += pnl
        dayLosses += pnl < 0 ? 1 : 0
        label.new(bar_index, pos > 0 ? high : low, why + " " + (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#.##"),
             style = pos > 0 ? label.style_label_down : label.style_label_up, color = pnl >= 0 ? color.green : color.red,
             textcolor = color.white, size = size.tiny)
        alert(syminfo.ticker + " exit " + why + " P&L $" + str.tostring(pnl, "#.##") + " | day $" + str.tostring(dayPnl, "#.##"), alert.freq_once_per_bar_close)
        pos := 0

// ───────────────────────── signals (closed bars only)
canEnter = barstate.isconfirmed and pos == 0 and not locked and clMin >= 575 and clMin < 950 and not inBlackout(clMin)

bool  orbLong = false
bool  orbShort = false
if mode != "Gap Fill" and not orbDone and etMin >= 570 + orMin and clMin <= orEnd and barstate.isconfirmed
    if close > orh
        orbLong := true
        orbDone := true
    else if close < orl
        orbShort := true
        orbDone := true
mid = (orh + orl) / 2

bool  gapLong = false
bool  gapShort = false
if mode != "ORB" and isOpenBar and barstate.isconfirmed and not na(pdc)
    g = (open - pdc) / pdc * 100
    if math.abs(g) >= gapMin and math.abs(g) <= gapMax
        if g > 0 and close < open and close - pdc >= gapMinRR * (high + tick - close)
            gapShort := true
        else if g < 0 and close > open and pdc - close >= gapMinRR * (close - (low - tick))
            gapLong := true

int    side = 0
float  sl = na
float  tp = na
string setup = ""
if canEnter
    if gapLong or gapShort
        side := gapLong ? 1 : -1
        sl := gapLong ? low - tick : high + tick
        tp := pdc
        setup := "GAP FILL"
    else if orbLong or orbShort
        side := orbLong ? 1 : -1
        sl := mid
        tp := close + orTpR * (close - mid)
        setup := "ORB"

qty = side != 0 ? sizeFor(close, sl) : 0
longSig  = side > 0 and qty >= 1
shortSig = side < 0 and qty >= 1

if longSig or shortSig
    e = close
    riskD = qty * ((math.abs(e - sl) + 2 * slipTicks * tick) * pv + commRT)
    tgtD  = qty * ((math.abs(tp - e) - slipTicks * tick) * pv - commRT)
    right = bar_index + math.max(1, int(math.round(maxHold / tfMin)))
    box.new(bar_index, math.max(e, tp), right, math.min(e, tp), border_color = color.new(color.green, 75), bgcolor = color.new(color.green, 75))
    box.new(bar_index, math.max(e, sl), right, math.min(e, sl), border_color = color.new(color.red, 75), bgcolor = color.new(color.red, 75))
    txt = (side > 0 ? "LONG " : "SHORT ") + setup + " (paper)" +
         "\nEntry " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) +
         "\nTP " + str.tostring(tp, format.mintick) + "\nMicros " + str.tostring(qty) +
         "\nRisk $" + str.tostring(riskD, "#") + "  Target $" + str.tostring(tgtD, "#")
    label.new(bar_index, side > 0 ? low : high, txt, style = side > 0 ? label.style_label_up : label.style_label_down,
         color = side > 0 ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small)
    alert(syminfo.ticker + " " + (side > 0 ? "LONG " : "SHORT ") + setup + " entry " + str.tostring(e, format.mintick) +
         " SL " + str.tostring(sl, format.mintick) + " TP " + str.tostring(tp, format.mintick) + " micros " + str.tostring(qty) +
         " risk $" + str.tostring(riskD, "#") + " target $" + str.tostring(tgtD, "#"), alert.freq_once_per_bar_close)
    pos := side
    ePx := e + side * slipTicks * tick
    sPx := sl
    tPx := tp
    eMin := clMin
    eQty := int(qty)
    eBar := bar_index

plotshape(longSig, "Long", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.red, size = size.small)
plot(etMin >= 570 + orMin and etMin < 960 and mode != "Gap Fill" ? orh : na, "OR high", color.new(color.gray, 30), style = plot.style_linebr)
plot(etMin >= 570 + orMin and etMin < 960 and mode != "Gap Fill" ? orl : na, "OR low", color.new(color.gray, 30), style = plot.style_linebr)
bgcolor(locked and etMin >= 570 and etMin < 960 ? color.new(color.red, 92) : na, title = "Daily loss lock")

alertcondition(longSig, "Long signal", "ORB/GAP paper: LONG signal")
alertcondition(shortSig, "Short signal", "ORB/GAP paper: SHORT signal")
alertcondition(locked and not locked[1], "Daily loss lock", "ORB/GAP paper: daily loss lock hit - stop trading today")

// ───────────────────────── ET session panel
sessName(int m, int dow) =>
    string s = ""
    if (dow == dayofweek.saturday) or (dow == dayofweek.sunday and m < 1080) or (dow == dayofweek.friday and m >= 1020)
        s := "Closed (weekend)"
    else if m >= 1080 or m < 180
        s := "Asia"
    else if m < 570
        s := "London / pre-market"
    else if m < 720
        s := "NY AM"
    else if m < 810
        s := "NY Lunch"
    else if m < 960
        s := "NY PM"
    else if m < 1020
        s := "Post-close"
    else
        s := "CME halt"
    s

var table panel = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast
    nowM = hour(timenow, tz) * 60 + minute(timenow, tz)
    txtc = color.white
    table.cell(panel, 0, 0, "ORB+GAP", text_color = color.yellow)
    table.cell(panel, 1, 0, "PAPER ONLY - unvalidated", text_color = color.yellow)
    table.cell(panel, 0, 1, "ET time", text_color = txtc)
    table.cell(panel, 1, 1, str.format_time(timenow, "HH:mm", tz), text_color = txtc)
    table.cell(panel, 0, 2, "Session", text_color = txtc)
    table.cell(panel, 1, 2, sessName(nowM, dayofweek(timenow, tz)), text_color = txtc)
    table.cell(panel, 0, 3, "Day P&L", text_color = txtc)
    table.cell(panel, 1, 3, "$" + str.tostring(dayPnl, "#.##"), text_color = dayPnl >= 0 ? color.lime : color.red)
    table.cell(panel, 0, 4, "Losses", text_color = txtc)
    table.cell(panel, 1, 4, str.tostring(dayLosses) + " / " + str.tostring(maxLosses), text_color = txtc)
    table.cell(panel, 0, 5, "Status", text_color = txtc)
    table.cell(panel, 1, 5, locked ? "LOCKED for today" : pos != 0 ? (pos > 0 ? "In LONG" : "In SHORT") : "Flat", text_color = locked ? color.red : txtc)
    table.cell(panel, 0, 6, "News today", text_color = txtc)
    table.cell(panel, 1, 6, (isFomc ? "FOMC 14:00 " : "") + (array.size(evMins) > 0 ? str.tostring(array.size(evMins)) + " blackout(s)" : (isFomc ? "" : "none")), text_color = txtc)
    table.cell(panel, 0, 7, "Chart TF", text_color = txtc)
    table.cell(panel, 1, 7, tfMin == 5 ? "5m OK" : "Use 5m chart!", text_color = tfMin == 5 ? txtc : color.red)
