{
  "name": "CopyGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "MT5",
        "Futures"
      ],
      "description": "MT5 accounts, or futures accounts (Tradovate / TradingView, which trade through Tradovate)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "When off, trades in this group are not copied"
    },
    "lead_account_id": {
      "type": "string",
      "description": "Account whose trades are copied to the others (Tradovate Group Trade: the first account added)"
    },
    "script_id": {
      "type": "string",
      "description": "Older single script; read together with script_ids"
    },
    "max_trades": {
      "type": "number",
      "default": 100,
      "description": "The group stops copying after this many trades"
    },
    "trades_made": {
      "type": "number",
      "default": 0
    },
    "script_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scripts whose signals this group trades (script_id is the single-script field from before)"
    },
    "blackout": {
      "type": "object",
      "description": "News, weekday, time-window and date blocks (server/lib/blackout.js)"
    }
  },
  "required": [
    "name",
    "platform"
  ]
}
