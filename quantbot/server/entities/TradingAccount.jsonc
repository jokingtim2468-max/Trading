{
  "name": "TradingAccount",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "MT5",
        "Tradovate",
        "TradingView"
      ]
    },
    "label": {
      "type": "string",
      "description": "Display name"
    },
    "login": {
      "type": "string",
      "description": "MT5 account number, or the Tradovate account name (e.g. LTT04821)"
    },
    "server": {
      "type": "string",
      "description": "MT5 trade server, e.g. FTMO-Demo"
    },
    "terminal_path": {
      "type": "string",
      "description": "Installed MT5 folder this account runs a private copy of"
    },
    "chart_symbol": {
      "type": "string",
      "default": "EURUSD",
      "description": "MT5 chart the bridge EA runs on"
    },
    "environment": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "demo",
      "description": "Tradovate server (prop accounts usually Demo)"
    },
    "account_spec": {
      "type": "string",
      "description": "Tradovate account name; empty uses the first account on the login"
    },
    "group_id": {
      "type": "string",
      "description": "CopyGroup id; empty means not copying"
    },
    "firm": {
      "type": "string",
      "description": "Prop firm or broker, e.g. Lucid Trading"
    },
    "copy_qty": {
      "type": "number",
      "default": 1,
      "description": "Contracts / lots this account takes per group trade (Tradovate Group Trade order quantity)"
    },
    "display_name": {
      "type": "string",
      "description": "Random name shown with the account's picture"
    },
    "avatar_seed": {
      "type": "string"
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "passed",
        "failed"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "default": "none",
      "description": "Account rules preset (copyRules PLANS)"
    },
    "start_balance": {
      "type": "number",
      "default": 50000
    },
    "balance": {
      "type": "number",
      "default": 50000
    },
    "target": {
      "type": "number",
      "description": "Profit that passes the account"
    },
    "max_loss": {
      "type": "number",
      "description": "Loss that fails the account"
    },
    "trailing": {
      "type": "boolean",
      "default": false,
      "description": "Max loss trails the best end-of-day balance (Lucid)"
    },
    "peak_eod": {
      "type": "number"
    },
    "floor": {
      "type": "number"
    },
    "day_key": {
      "type": "string"
    },
    "risk_share": {
      "type": "number",
      "description": "Size each trade so its stop risks this share of the smaller of the daily loss limit and the max loss (0.25 = a quarter); used when risk_usd is empty"
    },
    "risk_usd": {
      "type": "number",
      "description": "Size each trade so its stop risks this many dollars; empty uses the script's quantity x copy_qty"
    },
    "forward_url": {
      "type": "string",
      "description": "Optional order URL (e.g. a TradersPost webhook) that places the trades for real"
    },
    "stage": {
      "type": "string",
      "enum": [
        "evaluation",
        "challenge",
        "verification",
        "funded"
      ],
      "description": "Where a prop account is: evaluation / FTMO Challenge / Verification, or funded"
    },
    "daily_loss": {
      "type": "number",
      "description": "Loss in one trading day that fails the account (FTMO 5%)"
    },
    "day_start": {
      "type": "number",
      "description": "Balance at the start of the current trading day"
    },
    "day_zone": {
      "type": "string",
      "description": "Time zone of the trading day (FTMO Europe/Prague, Lucid America/New_York)"
    },
    "status_reason": {
      "type": "string"
    },
    "mt5_on": {
      "type": "boolean",
      "default": false,
      "description": "Send this account's copied trades to its MT5 terminal (QuantBot Copier EA)"
    },
    "symbol_map": {
      "type": "string",
      "description": "Signal symbol to the account's symbol, e.g. MGC1!=XAUUSD, MNQ1!=US100.cash"
    },
    "mt5_seen_at": {
      "type": "string",
      "description": "Last time the MT5 copier EA asked for orders"
    },
    "auto_withdraw": {
      "type": "boolean",
      "default": false,
      "description": "Take the profit out on the firm's payout schedule (FTMO every 14 days)"
    },
    "payout_days": {
      "type": "number"
    },
    "split": {
      "type": "number",
      "description": "Profit split you keep (0.8 = 80%)"
    },
    "last_payout_at": {
      "type": "string"
    },
    "funded_at": {
      "type": "string"
    },
    "withdrawn": {
      "type": "number",
      "default": 0,
      "description": "Your share paid out so far"
    },
    "capital": {
      "type": "number",
      "description": "Account size / capital (multi-broker MT5)"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "The MT5 daemon keeps this account logged in"
    },
    "portable": {
      "type": "boolean",
      "default": true,
      "description": "Start the terminal in portable mode (its own data folder)"
    },
    "password_enc": {
      "type": "string",
      "description": "MT5 password, AES-256-GCM encrypted; never sent to the pages"
    },
    "daemon_state": {
      "type": "string",
      "enum": [
        "connected",
        "connecting",
        "error",
        "stopped"
      ]
    },
    "daemon_error": {
      "type": "string"
    },
    "daemon_seen_at": {
      "type": "string"
    },
    "broker_balance": {
      "type": "number"
    },
    "broker_equity": {
      "type": "number"
    },
    "broker_currency": {
      "type": "string"
    },
    "algo_trading": {
      "type": "boolean",
      "description": "The terminal's Algo Trading button is on"
    }
  },
  "required": [
    "platform",
    "label"
  ]
}
