// QuantBot · 1m Upgraded Exhaustion Engine (Pine Script v6)
// The trading logic below is the user's reference master, unchanged. Added only: QuantBot webhook alerts (entries and
// exits as JSON for the Signals page / copy trading) and an honest backtest note.
//
// BACKTEST (QuantBot, exact bar-by-bar replica, XAUUSD M5, 2004-06 to 2026-10, 15,922 trades, real spread from the data):
//   TP 1:2.0, SL checked first: win 34.0%, profit factor 0.87, net -1,549 R, max drawdown 1,708 R
//   2026 so far: PF 1.03, +11.8 R. 2025-26 at $75 risk: about +$5 a week on average, 55 of 94 weeks lost.
//   Without any spread: PF 1.03 (+317 R in 22 years). The spread alone turns it into a loser.
//   TP 1:1.5 and 1:1.0 are worse (PF 0.83 and 0.80). Do not run it on a paid account as it is.
//
// Alerts: add ONE alert on this indicator, condition "Any alert() function call", webhook URL = your QuantBot signal
// address (Signals page), message left empty (the script writes the JSON).
//@version=6
indicator("1m Upgraded Exhaustion Engine", shorttitle="1m Exhaustion Pro", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)
string gP = "Prop Firm Profile"
string firmProfile  = input.string("Lucid Trading (LucidFlex)", "Firm Profile", options=["Lucid Trading (LucidFlex)", "Lucid Trading (LucidPro)", "FTMO (Evaluation)", "FTMO (Funded)"], group=gP)
float riskPerTrade  = input.float(75.0, "Risk per Trade ($)", group=gP)
float tpRatio       = input.float(2.0, "Take Profit Ratio (1:2)", step=0.1, group=gP)
float dailyTarget   = input.float(600.0, "Daily Profit Cap ($)", step=50.0, group=gP)
float maxDailyLoss  = input.float(-200.0, "Daily Max Loss Floor ($)", step=50.0, group=gP)
float minStopFloor  = input.float(1.5, "Min Stop Distance Floor (Pts)", step=0.1, group=gP)
string gW = "QuantBot webhook"
bool   sendAlerts   = input.bool(true, "Send entries and exits to QuantBot", group=gW)
string botName      = input.string("QB Exhaustion", "Script name in QuantBot", group=gW)
float fastAtr = ta.atr(7)
float bodySize = math.abs(close - open)
float topWick = high - math.max(close, open)
float bottomWick = math.min(close, open) - low
float avgBody = ta.sma(bodySize, 5)
bool red1 = close < open
bool red2 = close[1] < open[1]
bool red3 = close[2] < open[2]
bool red4 = close[3] < open[3]
bool green1 = close > open
bool green2 = close[1] > open[1]
bool green3 = close[2] > open[2]
bool green4 = close[3] > open[3]
bool exBuy  = red1 and red2 and red3 and red4
bool exSell = green1 and green2 and green3 and green4
bool topRej = topWick[1] > (bodySize[1] * 1.5) and topWick[1] > (fastAtr[1] * 0.8)
bool botRej = bottomWick[1] > (bodySize[1] * 1.5) and bottomWick[1] > (fastAtr[1] * 0.8)
bool strongBear = close < open and bodySize > (avgBody * 1.2) and bodySize > fastAtr
bool strongBull = close > open and bodySize > (avgBody * 1.2) and bodySize > fastAtr
bool momBuy  = close > open and bodySize > (nz(avgBody[1]) * 3.0) and close > high[1] and topWick < (bodySize * 0.2)
bool momSell = close < open and bodySize > (nz(avgBody[1]) * 3.0) and close < low[1] and bottomWick < (bodySize * 0.2)
bool baseBuy  = exBuy or (botRej and strongBull) or momBuy
bool baseSell = exSell or (topRej and strongBear) or momSell
var int   pos         = 0       
var float entryPrice  = na
var float slPrice     = na
var float tpPrice     = na
var int   entryBar    = na
var float dailyPnL    = 0.0
var int   dailyLosses = 0
var bool  botDisabled = false
var string tradeId    = ""
if dayofweek != dayofweek[1]
    dailyPnL    := 0.0
    dailyLosses := 0
    botDisabled := false
if dailyPnL <= maxDailyLoss or dailyPnL >= dailyTarget or dailyLosses >= 2
    botDisabled := true
bool buySignal  = baseBuy and not botDisabled and pos == 0 and barstate.isconfirmed
bool sellSignal = baseSell and not botDisabled and pos == 0 and barstate.isconfirmed
plotshape(sellSignal, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
plotshape(buySignal,  title="Long Entry",  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.small)
var box   bxRisk = na
var box   bxRew  = na
var line  lnSL   = na
var line  lnTP   = na
var label lblSL  = na
var label lblTP  = na
// QuantBot signal JSON (same format as the Signals page)
qbMsg(string ev, float px, float s, float t, string reason) =>
    '{"qb":1,"event":"' + ev + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + str.tostring(px, format.mintick) + (na(s) ? '' : ',"sl":' + str.tostring(s, format.mintick)) + (na(t) ? '' : ',"tp":' + str.tostring(t, format.mintick)) + ',"risk_usd":' + str.tostring(riskPerTrade) + ',"trade_id":"' + tradeId + '","reason":"' + reason + '","strategy":"' + botName + '","source":"tradingview","time":' + str.tostring(time_close) + '}'
if pos != 0
    bool hitSL = (pos == 1 and low <= slPrice) or (pos == -1 and high >= slPrice)
    bool hitTP = (pos == 1 and high >= tpPrice) or (pos == -1 and low <= tpPrice)
    if not hitTP and not hitSL 
        box.set_right(bxRisk, bar_index + 2)
        box.set_right(bxRew, bar_index + 2)
        line.set_x2(lnSL, bar_index + 2)
        line.set_x2(lnTP, bar_index + 2)
        label.set_x(lblSL, bar_index + 2)
        label.set_x(lblTP, bar_index + 2)
    if hitTP or hitSL 
        float tradeUSD = hitTP ? (riskPerTrade * tpRatio) : -riskPerTrade
        dailyPnL += tradeUSD
        if not hitTP
            dailyLosses += 1
        if sendAlerts
            alert(qbMsg("close", hitTP ? tpPrice : slPrice, na, na, hitTP ? "tp" : "sl"), alert.freq_once_per_bar)
        pos := 0
        entryPrice := na
        slPrice := na
        tpPrice := na
if pos == 0 and (buySignal or sellSignal)
    box.delete(bxRisk)
    box.delete(bxRew)
    line.delete(lnSL)
    line.delete(lnTP)
    label.delete(lblSL)
    label.delete(lblTP)
    entryPrice := close
    entryBar := bar_index
    tradeId := botName + "-" + str.tostring(time)
    if buySignal
        pos := 1
        float rawSlDist = entryPrice - (math.min(low, low[1]) - (fastAtr * 0.2))
        float slDist = math.max(rawSlDist, minStopFloor)
        slPrice := entryPrice - slDist
        tpPrice := entryPrice + (slDist * tpRatio)
    else if sellSignal
        pos := -1
        float rawSlDist = (math.max(high, high[1]) + (fastAtr * 0.2)) - entryPrice
        float slDist = math.max(rawSlDist, minStopFloor)
        slPrice := entryPrice + slDist
        tpPrice := entryPrice - (slDist * tpRatio)
    if sendAlerts
        alert(qbMsg(pos == 1 ? "buy" : "sell", entryPrice, slPrice, tpPrice, ""), alert.freq_once_per_bar_close)
    bxRisk := box.new(entryBar, math.max(entryPrice, slPrice), entryBar + 2, math.min(entryPrice, slPrice), border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 85))
    bxRew  := box.new(entryBar, math.max(entryPrice, tpPrice), entryBar + 2, math.min(entryPrice, tpPrice), border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 85))
    lnSL := line.new(entryBar, slPrice, entryBar + 2, slPrice, color=color.red, width=2)
    lnTP := line.new(entryBar, tpPrice, entryBar + 2, tpPrice, color=color.green, width=2)
    lblSL := label.new(entryBar + 2, slPrice, "SL", style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    lblTP := label.new(entryBar + 2, tpPrice, "TP", style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)
var table pnlDash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 30), border_color=color.new(color.gray, 60), border_width=1)
if barstate.islast
    color pnlColor = dailyPnL >= 0 ? color.lime : color.red
    string statusText = botDisabled ? (dailyPnL >= dailyTarget ? "TARGET REACHED 🎯" : "DAILY STOP LOCK 🛑") : (pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "ACTIVE")
    table.cell(pnlDash, 0, 0, "Firm", text_color=color.white, text_size=size.small)
    table.cell(pnlDash, 1, 0, firmProfile, text_color=color.cyan, text_size=size.small)
    table.cell(pnlDash, 0, 1, "Status", text_color=color.gray, text_size=size.small)
    table.cell(pnlDash, 1, 1, statusText, text_color=botDisabled ? color.orange : color.green, text_size=size.small)
    table.cell(pnlDash, 0, 2, "Daily P&L", text_color=color.gray, text_size=size.small)
    table.cell(pnlDash, 1, 2, (dailyPnL >= 0 ? "+$" : "-$") + str.tostring(math.abs(dailyPnL), "#,##0.00"), text_color=pnlColor, text_size=size.small)
