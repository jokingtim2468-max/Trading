// QuantBot · Signal Bot (Pine Script v6) — NQ / MNQ (works on gold too), 5-minute chart. Signals only, no auto trading.
// Tells you BUY or SELL, where the entry, stop (SL) and target (TP) are, and how many contracts fit your $ risk.
// Two setups, from QuantBot's research (scripts/strategy-lab.py, scripts/aplus-grid.py, scripts/opening-drive-lab.py):
//   1. Opening drive: the 09:30 New York bar is strong (body >= 0.5 ATR), goes the same way as the overnight gap and
//      breaks the overnight high/low -> trade that way. SL 1 ATR, TP 2R.
//   2. VWAP fade with the trend: after 10:00, price pulls back 2.5 deviations below the session VWAP while above the
//      200 EMA (buy), or 2.5 above it while below the 200 EMA (sell). SL 2 ATR, TP 2R.
//   3. Opening-range breakout (off by default): the first 5 minutes after the open, broken in the 200-EMA direction,
//      stop = the range. The yearly loop picked this on gold for 2026 (4 past years positive; 2026 so far ~breakeven).
// BOT IMPROVER (scripts/bot-improver.py v2, research/bot-best-v2.json): best so far = opening drive with the gap and
//   the trend, stop 2 ATR, add 2-3 units at +1R/+2R/+3R raising the stop each time, trail 4 ATR, out at 15:55.
//   Walk-forward 2019-2025 +681.5R (no losing year), 2026 exam +25.5R (R = the first unit's stop). These defaults.
// WALK-FORWARD 2017-2026 (scripts/signal-bot-loop.py, each year chosen only on the 4 years before it):
//   1,367 trades, 20% winners (small losses, a few big winners), +0.169R per trade, +231R = +$23,108 at $100 risk.
//   Most of it came in 2019 and 2021 (NQ opening drive). 2022-2025 were small losses (-$205 to -$2,376 a year).
// One signal a day (the first one), nothing after 15:30, everything should be flat by 15:55 (Lucid: 16:45).
// HONEST RESULTS so far (unseen years, costs included): both setups are small edges, about breakeven to slightly
// positive per trade; most weeks are flat or small losses and a few big days pay. Size small. The test -> improve loop
// (scripts/signal-bot-loop.py) re-checks every setting each year; its latest log is in research/signal-bot-choice.json.
// Alerts: one alert on this indicator, condition "Any alert() function call", webhook = your QuantBot signal address.
//@version=6
indicator("QuantBot Signal Bot", shorttitle="QB Signals", overlay=true, max_labels_count=500, max_lines_count=500)

string gR = "Risk"
float riskUsd   = input.float(100.0, "Risk per trade ($)", minval=10, step=10, group=gR)
int   maxQty    = input.int(100, "Max contracts", minval=1, group=gR)
float tpR       = input.float(2.0, "Target (x the stop)", minval=0.5, step=0.25, group=gR)
string gS = "Setups"
bool useDrive   = input.bool(true, "Opening drive", group=gS)
float driveBody = input.float(0.5, "Opening drive: first bar body (x ATR)", minval=0, step=0.1, group=gS)
float driveStop = input.float(2.0, "Opening drive: stop (x ATR)", minval=0.25, step=0.25, group=gS)
int  driveAdds  = input.int(3, "Opening drive: add a unit at +1R, +2R... (0 = no adds)", minval=0, maxval=5, group=gS)
float driveTrail = input.float(4.0, "Opening drive: trail the stop this many ATR behind the best price (after +1R)", minval=0, step=0.5, group=gS)
bool useFade    = input.bool(true, "VWAP fade with the trend", group=gS)
float fadeZ     = input.float(2.5, "VWAP fade: deviations from VWAP", minval=1, step=0.25, group=gS)
float fadeStop  = input.float(2.0, "VWAP fade: stop (x ATR)", minval=0.25, step=0.25, group=gS)
bool useOrb     = input.bool(false, "Opening-range breakout (gold: the loop's 2026 pick)", group=gS)
int  orbStart   = input.int(500, "ORB start (NY minutes after midnight; gold 500 = 08:20, NQ 570 = 09:30)", group=gS)
int  orbMins    = input.int(5, "ORB length (minutes)", minval=5, step=5, group=gS)
bool onePerDay  = input.bool(true, "One signal a day", group=gS)
string gW = "QuantBot webhook"
bool sendAlerts = input.bool(true, "Send signals to QuantBot", group=gW)
string botName  = input.string("QB Signal Bot", "Script name in QuantBot", group=gW)
string tz = "America/New_York"

int m = hour(time, tz) * 60 + minute(time, tz)
bool rthStart = m == 570
bool newDay = ta.change(time("D", "", tz)) != 0
float atr = ta.atr(14)
float ema200 = ta.ema(close, 200)

// overnight high/low (18:00-09:30) and the previous regular-session close (15:55 bar)
var float onH = na
var float onL = na
var float prevClose = na
var float lastClose = na
if m >= 18 * 60 and m[1] < 18 * 60
    onH := high, onL := low
else if m >= 18 * 60 or m < 570
    onH := math.max(nz(onH, high), high), onL := math.min(nz(onL, low), low)
if m == 955
    lastClose := close
if rthStart
    prevClose := lastClose

// opening range (gold: COMEX open 08:20) -> breakout in the 200-EMA direction, stop = the range (at least 0.5 ATR)
var float orH = na
var float orL = na
if m == orbStart
    orH := high, orL := low
else if m > orbStart and m < orbStart + orbMins
    orH := math.max(orH, high), orL := math.min(orL, low)

// session VWAP from 09:30 with deviation bands
[vw, vwUp, vwDn] = ta.vwap(hlc3, rthStart, fadeZ)

var bool tookToday = false
if newDay
    tookToday := false

int side = 0
float stopDist = na
string why = ""
if useDrive and rthStart and barstate.isconfirmed
    int d = close > open ? 1 : close < open ? -1 : 0
    float gap = open - nz(prevClose, open)
    bool strong = math.abs(close - open) >= driveBody * atr
    bool withGap = math.sign(gap) == d
    bool breaks = (d == 1 and close > onH[1]) or (d == -1 and close < onL[1])
    if d != 0 and strong and withGap and breaks
        side := d, stopDist := driveStop * atr, why := "Opening drive"
if side == 0 and useFade and m >= 600 and m < 930 and barstate.isconfirmed and not na(vwUp)
    if close < vwDn and close > ema200
        side := 1, stopDist := fadeStop * atr, why := "VWAP fade (trend up)"
    else if close > vwUp and close < ema200
        side := -1, stopDist := fadeStop * atr, why := "VWAP fade (trend down)"
if side == 0 and useOrb and m >= orbStart + orbMins and m < orbStart + 180 and barstate.isconfirmed and not na(orH)
    if close > orH and close[1] <= orH and close > ema200
        side := 1, stopDist := math.max(orH - orL, 0.5 * atr), why := "Opening-range breakout"
    else if close < orL and close[1] >= orL and close < ema200
        side := -1, stopDist := math.max(orH - orL, 0.5 * atr), why := "Opening-range breakout"
if m >= 930 or (onePerDay and tookToday)
    side := 0

qbMsg(string ev, float px, float s, float t, int q) =>
    '{"qb":1,"event":"' + ev + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + str.tostring(px, format.mintick) + ',"sl":' + str.tostring(s, format.mintick) + ',"tp":' + str.tostring(t, format.mintick) + ',"qty":' + str.tostring(q) + ',"risk_usd":' + str.tostring(riskUsd) + ',"reason":"' + why + '","strategy":"' + botName + '","source":"tradingview","time":' + str.tostring(time_close) + '}'

var line slL = na
var line tpL = na
var line enL = na
if side != 0
    tookToday := true
    float e = close
    float sl = e - side * stopDist
    bool isDrive = why == "Opening drive"
    float tp = isDrive and driveAdds > 0 ? e + side * (driveAdds + 1) * stopDist : e + side * tpR * stopDist
    float perC = stopDist * syminfo.pointvalue
    int q = perC > 0 ? math.min(maxQty, math.max(1, int(math.floor(riskUsd / perC)))) : 1
    line.delete(slL), line.delete(tpL), line.delete(enL)
    enL := line.new(bar_index, e, bar_index + 30, e, color=color.new(color.gray, 20), style=line.style_dotted)
    slL := line.new(bar_index, sl, bar_index + 30, sl, color=#ef4444, width=2)
    tpL := line.new(bar_index, tp, bar_index + 30, tp, color=#22c55e, width=2, style=isDrive and driveAdds > 0 ? line.style_dashed : line.style_solid)
    if isDrive and driveAdds > 0
        for k = 1 to driveAdds
            float lv = e + side * k * stopDist
            line.new(bar_index, lv, bar_index + 30, lv, color=color.new(#60a5fa, 30), style=line.style_dotted)
            label.new(bar_index + 30, lv, "add " + str.tostring(k) + " · stop to " + str.tostring(e + side * (k - 1) * stopDist, format.mintick), style=label.style_label_left, color=color.new(#60a5fa, 70), textcolor=color.white, size=size.tiny)
    label.new(bar_index, side == 1 ? low - atr * 0.4 : high + atr * 0.4,
         (side == 1 ? "BUY " : "SELL ") + str.tostring(q) + "\nSL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick) + "\nRisk $" + str.tostring(q * perC, "#,##0") + " · " + why + (isDrive and driveAdds > 0 ? "\nAdd " + str.tostring(q) + " at each blue line, trail " + str.tostring(driveTrail) + " ATR, out 15:55" : ""),
         style=side == 1 ? label.style_label_up : label.style_label_down, color=color.new(side == 1 ? #22c55e : #ef4444, 10), textcolor=color.white, size=size.small)
    if sendAlerts
        alert(qbMsg(side == 1 ? "buy" : "sell", e, sl, tp, q), alert.freq_once_per_bar_close)
if m == 955 and sendAlerts and tookToday
    alert('{"qb":1,"event":"close_all","symbol":"' + syminfo.ticker + '","reason":"15:55 flat","strategy":"' + botName + '","source":"tradingview"}', alert.freq_once_per_bar_close)

plot(vw, "Session VWAP", color=color.new(#60a5fa, 30), style=plot.style_linebr)
plot(useFade ? vwUp : na, "VWAP upper", color=color.new(#60a5fa, 75), style=plot.style_linebr)
plot(useFade ? vwDn : na, "VWAP lower", color=color.new(#60a5fa, 75), style=plot.style_linebr)
plot(ema200, "EMA 200 (trend)", color=color.new(color.orange, 40))
bgcolor(m >= 570 and m < 930 ? color.new(#60a5fa, 95) : na, title="Signal hours")
