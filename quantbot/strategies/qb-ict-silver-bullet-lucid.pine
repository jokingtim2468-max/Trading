// QuantBot · ICT Silver Bullet for LucidFlex 150K (Pine Script v6 strategy) — MNQ / MGC, 5-minute chart
// Rules (same as scripts/ict-sb-lucid.py, which replays them on QuantBot's data):
//   - window 10:00-11:00 New York; liquidity = overnight high/low (00:00-09:30) and the 09:30-10:00 range
//   - sweep of that liquidity, then a market structure shift: close beyond the last 1-1 pivot the other way, on a
//     displacement bar (range > 1 x ATR14, volume above its 20-bar average when the feed has real volume)
//   - the displacement leaves a fair value gap; limit entry at its middle, stop beyond the sweep extreme, target 2R
//   - unfilled orders cancelled at 11:30; everything flat at 15:55
//   - size: fixed $ risk / (stop x point value), never a % of the balance; day stops at +$250 or -$300 / 2 losses
// REPLAY RESULT (QuantBot data, costs included, fixed $150 risk):
//   NQ 2012-2026: 118 trade days in 14 years, 33% winning days, -$2,535 total, avg week -$3, worst drawdown $3,426
//   NQ 2022-2026: 42 trade days, +$730 total, avg week +$1.   XAUUSD 2004-2026: 67 trade days, -$107 total.
//   The full setup is rare (about 8 days a year on NQ) and has no edge after costs. Run TradingView's Strategy Tester
//   on your own feed before trusting it with money.
//@version=6
strategy("QB ICT Silver Bullet (Lucid 150K)", shorttitle="QB SB Lucid", overlay=true, initial_capital=150000, commission_type=strategy.commission.cash_per_contract, commission_value=0.75, slippage=1, process_orders_on_close=false, max_labels_count=500, max_boxes_count=500)

string gR = "Risk (Lucid)"
float riskUsd   = input.float(150.0, "Risk per trade ($)", minval=10, step=10, group=gR)
float rr        = input.float(2.0, "Reward : risk", minval=1.0, step=0.5, group=gR)
float dayCap    = input.float(250.0, "Daily profit cap ($)", minval=0, step=50, group=gR)
float dayStop   = input.float(300.0, "Daily loss limit ($)", minval=50, step=50, group=gR)
int   maxLosses = input.int(2, "Losing trades per day", minval=1, group=gR)
int   maxQty    = input.int(100, "Max contracts (Lucid 150K: 100 micros / 10 minis)", minval=1, group=gR)
string gE = "Entry"
float dispAtr   = input.float(1.0, "Displacement: bar range > x ATR14", minval=0.5, step=0.1, group=gE)
bool  useVol    = input.bool(true, "Volume confluence (bar volume > 20-bar average)", group=gE)
string tz       = "America/New_York"

// ── New York clock ─────────────────────────────────────────────────────────────────────────────
int m = hour(time, tz) * 60 + minute(time, tz)
bool newDay = ta.change(time("D", "", tz)) != 0
bool pre = m < 570
bool orr = m >= 570 and m < 600
bool win = m >= 600 and m < 660

var float onH = na
var float onL = na
var float orH = na
var float orL = na
var int swept = 0
var float sweepExt = na
var float dayStartProfit = 0.0
var int dayLosses = 0
var int lastClosed = 0
if newDay
    onH := high, onL := low, orH := na, orL := na, swept := 0, sweepExt := na
    dayStartProfit := strategy.netprofit, dayLosses := 0
if pre and not newDay
    onH := math.max(onH, high), onL := math.min(onL, low)
if orr
    orH := na(orH) ? high : math.max(orH, high), orL := na(orL) ? low : math.min(orL, low)

// losses closed today
if strategy.closedtrades > lastClosed
    for i = lastClosed to strategy.closedtrades - 1
        if strategy.closedtrades.profit(i) < 0
            dayLosses += 1
    lastClosed := strategy.closedtrades
float dayPnl = strategy.netprofit - dayStartProfit + strategy.openprofit
bool dayDone = dayPnl >= dayCap or dayPnl <= -dayStop or dayLosses >= maxLosses

// ── Liquidity sweep → MSS with displacement → FVG ──────────────────────────────────────────────
float liqH = math.min(nz(onH, high), nz(orH, high))
float liqL = math.max(nz(onL, low), nz(orL, low))
if win and high > liqH
    sweepExt := swept == -1 ? math.max(sweepExt, high) : high
    swept := -1
if win and low < liqL
    sweepExt := swept == 1 ? math.min(sweepExt, low) : low
    swept := 1
float ph = ta.valuewhen(not na(ta.pivothigh(high, 1, 1)), high[1], 0)
float pl = ta.valuewhen(not na(ta.pivotlow(low, 1, 1)), low[1], 0)
float atr = ta.atr(14)
bool volOk = not useVol or na(volume) or volume > ta.sma(volume, 20)
bool disp = (high - low) > dispAtr * atr and volOk
bool bullFvg = low > high[2]
bool bearFvg = high < low[2]
bool longSetup  = win and swept == 1 and disp and close > open and close > ph and bullFvg
bool shortSetup = win and swept == -1 and disp and close < open and close < pl and bearFvg

// ── Orders: fixed $ risk sizing ────────────────────────────────────────────────────────────────
qtyFor(float stopDist) =>
    float perContract = stopDist * syminfo.pointvalue
    int q = perContract > 0 ? int(math.floor(riskUsd / perContract)) : 0
    q := q < 1 and perContract <= 2 * riskUsd ? 1 : q
    math.min(q, maxQty)

if strategy.position_size == 0 and not dayDone and barstate.isconfirmed
    if longSetup
        float ent = (low + high[2]) / 2
        float sl = sweepExt - syminfo.mintick
        int q = qtyFor(ent - sl)
        if q > 0
            strategy.entry("SB long", strategy.long, qty=q, limit=ent)
            strategy.exit("SB long exit", "SB long", stop=sl, limit=ent + rr * (ent - sl))
            box.new(bar_index - 2, low, bar_index + 6, high[2], border_color=color.new(#22c55e, 30), bgcolor=color.new(#22c55e, 85))
            label.new(bar_index, sl, "SB long " + str.tostring(q) + " · risk $" + str.tostring(q * (ent - sl) * syminfo.pointvalue, "#"), style=label.style_label_up, color=color.new(#22c55e, 20), textcolor=color.white, size=size.small)
    if shortSetup
        float ent = (high + low[2]) / 2
        float sl = sweepExt + syminfo.mintick
        int q = qtyFor(sl - ent)
        if q > 0
            strategy.entry("SB short", strategy.short, qty=q, limit=ent)
            strategy.exit("SB short exit", "SB short", stop=sl, limit=ent - rr * (sl - ent))
            box.new(bar_index - 2, low[2], bar_index + 6, high, border_color=color.new(#ef4444, 30), bgcolor=color.new(#ef4444, 85))
            label.new(bar_index, sl, "SB short " + str.tostring(q) + " · risk $" + str.tostring(q * (sl - ent) * syminfo.pointvalue, "#"), style=label.style_label_down, color=color.new(#ef4444, 20), textcolor=color.white, size=size.small)

if m >= 690 and strategy.position_size == 0
    strategy.cancel_all()
if m >= 955 or dayDone
    strategy.cancel_all()
    strategy.close_all(comment="day end / day limit")

// ── Visuals ────────────────────────────────────────────────────────────────────────────────────
bgcolor(win ? color.new(#60a5fa, 92) : na, title="Silver Bullet window")
plot(liqH, "Buy-side liquidity", color=color.new(#60a5fa, 30), style=plot.style_linebr)
plot(liqL, "Sell-side liquidity", color=color.new(#60a5fa, 30), style=plot.style_linebr)
var table t = table.new(position.top_right, 2, 4, bgcolor=color.new(#0b0b0c, 15), border_color=color.new(color.gray, 70), border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "QB Silver Bullet", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, dayDone ? "day done" : win ? "window open" : "waiting", text_color=dayDone ? color.orange : color.gray, text_size=size.small)
    table.cell(t, 0, 1, "Day P&L", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 1, (dayPnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(dayPnl), "#,##0"), text_color=dayPnl >= 0 ? #22c55e : #ef4444, text_size=size.small)
    table.cell(t, 0, 2, "Losses today", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 2, str.tostring(dayLosses) + " / " + str.tostring(maxLosses), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 3, "Risk / trade", text_color=color.gray, text_size=size.small)
    table.cell(t, 1, 3, "$" + str.tostring(riskUsd, "#"), text_color=color.white, text_size=size.small)
