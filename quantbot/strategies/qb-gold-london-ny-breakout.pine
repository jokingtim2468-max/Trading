// Script: QB Gold London-NY Breakout
//@version=5
// XAUUSD M5. London range = 02:00-05:00 New York. From 08:30 to 11:00 NY the first 5-minute close outside the range
// enters (one breakout per day). Stop at the middle of the range, taken only when that is at least $4 away; target
// 1.5R; out after 2 hours. Same rules as QuantBot's backtest (scripts/xau-london-ny.sim.js). The draw-on-liquidity line
// (where price is likely heading next) is drawn alongside and does not change the trades.
strategy("QB Gold London-NY Breakout", overlay=true, initial_capital=10000, pyramiding=0,
     process_orders_on_close=false, calc_on_every_tick=false,
     max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ---------- Inputs
G_S = "Strategy"
rangeSess  = input.session("0200-0500", "London range (New York time)", group=G_S)
entrySess  = input.session("0830-1100", "Entry window (New York time)", group=G_S)
tpR        = input.float(1.5, "Target (R)", minval=0.5, step=0.25, group=G_S)
minStop    = input.float(4.0, "Minimum stop distance (price)", minval=0, step=0.5, group=G_S)
maxStop    = input.float(0.0, "Maximum stop distance (price, 0 = off)", minval=0, step=1, group=G_S)
maxHoldMin = input.int(120, "Max time in a trade (minutes)", minval=5, group=G_S)
flatHour   = input.int(16, "Flat by (New York hour)", minval=0, maxval=23, group=G_S)
G_R = "Risk"
riskPct    = input.float(1.0, "Risk per trade (% of equity)", minval=0.05, step=0.05, group=G_R)
G_V = "Visuals"
showBg     = input.bool(true, "Shade the range and entry window", group=G_V)
showRange  = input.bool(true, "London range box and levels", group=G_V)
showTrades = input.bool(true, "Entry, SL and TP lines and boxes", group=G_V)
showPanel  = input.bool(true, "Dashboard", group=G_V)
G_Q = "QuantBot"
qbOn       = input.bool(true, "Send QuantBot signals (alert)", group=G_Q)
qbName     = input.string("QB Gold London-NY Breakout", "QuantBot strategy name", group=G_Q)

// ---------- Colours
cBlue  = #5fb7f2
cAmber = #f59e0b
cRed   = #ef4343
cGreen = #22c55e
cText  = #e5e7eb
cMuted = #9ca3af

// ---------- Time (New York, daylight saving handled by the time zone)
TZ = "America/New_York"
inRange  = not na(time(timeframe.period, rangeSess, TZ))
inEntry  = not na(time(timeframe.period, entrySess, TZ))
nyDow    = dayofweek(time, TZ)
weekday  = nyDow >= dayofweek.monday and nyDow <= dayofweek.friday
nyDate   = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
nyHour   = hour(time, TZ)

bgcolor(showBg and inRange ? color.new(cBlue, 92) : showBg and inEntry ? color.new(cAmber, 94) : na)

// ---------- QuantBot webhook messages (one alert on the script: "Any alert() function call")
qbSend(string ev, float px, float sl, float tp, float qty, string reason, string tradeId) =>
    string msg = '{"qb":1,"event":"' + ev + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + str.tostring(math.round_to_mintick(px))
    if not na(sl)
        msg := msg + ',"sl":' + str.tostring(math.round_to_mintick(sl))
    if not na(tp)
        msg := msg + ',"tp":' + str.tostring(math.round_to_mintick(tp))
    if not na(qty)
        msg := msg + ',"qty":' + str.tostring(qty)
    msg := msg + ',"trade_id":"' + tradeId + '","reason":"' + reason + '","strategy":"' + qbName + '","source":"tradingview","time":' + str.tostring(time) + '}'
    if qbOn
        alert(msg, alert.freq_once_per_bar_close)

// ---------- London range for today's New York date
var float rHi = na
var float rLo = na
var int rDate = na
var bool rReady = false
var bool doneToday = false
var box rBox = na
var line hiLn = na
var line loLn = na
var line midLn = na

if inRange and not inRange[1]
    rHi := high
    rLo := low
    rDate := nyDate
    rReady := false
    doneToday := false
    if showRange
        rBox := box.new(bar_index, high, bar_index, low, border_color=color.new(cBlue, 30), bgcolor=color.new(cBlue, 85), text="LONDON RANGE", text_color=color.new(cBlue, 10), text_size=size.tiny, text_halign=text.align_left, text_valign=text.align_top)
else if inRange
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)
    if showRange and not na(rBox)
        box.set_right(rBox, bar_index)
        box.set_top(rBox, rHi)
        box.set_bottom(rBox, rLo)

if not inRange and inRange[1] and not na(rHi)
    rReady := true
    if showRange
        // Levels carried through the New York entry window (about 6 hours of 5-minute bars)
        hiLn := line.new(bar_index, rHi, bar_index + 72, rHi, color=color.new(cGreen, 20), style=line.style_dotted, width=1)
        loLn := line.new(bar_index, rLo, bar_index + 72, rLo, color=color.new(cRed, 20), style=line.style_dotted, width=1)
        midLn := line.new(bar_index, (rHi + rLo) / 2, bar_index + 72, (rHi + rLo) / 2, color=color.new(cMuted, 30), style=line.style_dashed, width=1)
        label.new(bar_index + 72, rHi, "LONDON HIGH " + str.tostring(rHi, format.mintick), style=label.style_none, textcolor=cGreen, size=size.tiny)
        label.new(bar_index + 72, rLo, "LONDON LOW " + str.tostring(rLo, format.mintick), style=label.style_none, textcolor=cRed, size=size.tiny)

// ---------- Entries
rMid = (rHi + rLo) / 2
canTrade = rReady and rDate == nyDate and not doneToday and inEntry and weekday and strategy.position_size == 0 and barstate.isconfirmed
upBreak = canTrade and close > rHi
dnBreak = canTrade and close < rLo

qtyFor(float stopDist) =>
    float riskMoney = strategy.equity * riskPct / 100
    float raw = riskMoney / (stopDist * syminfo.pointvalue)
    syminfo.type == "futures" ? float(math.max(1, math.floor(raw))) : math.max(0.01, math.floor(raw * 100) / 100)

bool longSig = false
bool shortSig = false
var string lastEvent = "-"
var string tradeId = ""

if upBreak or dnBreak
    doneToday := true
    float risk = math.abs(close - rMid)
    if risk >= minStop and (maxStop == 0 or risk <= maxStop)
        float q = qtyFor(risk)
        float sl = rMid
        float tp = upBreak ? close + tpR * risk : close - tpR * risk
        tradeId := qbName + "-" + str.tostring(time)
        if upBreak
            strategy.entry("BUY", strategy.long, qty=q)
            strategy.exit("BUY X", "BUY", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
            longSig := true
            qbSend("buy", close, sl, tp, q, "", tradeId)
            lastEvent := "BUY " + str.tostring(close, format.mintick)
        else
            strategy.entry("SELL", strategy.short, qty=q)
            strategy.exit("SELL X", "SELL", stop=sl, limit=tp, comment_loss="SL", comment_profit="TP")
            shortSig := true
            qbSend("sell", close, sl, tp, q, "", tradeId)
            lastEvent := "SELL " + str.tostring(close, format.mintick)
        if showTrades
            int b2 = bar_index + math.max(1, math.round(float(maxHoldMin) * 60.0 / timeframe.in_seconds()))
            box.new(bar_index, close, b2, sl, border_color=na, bgcolor=color.new(cRed, 85))
            box.new(bar_index, close, b2, tp, border_color=na, bgcolor=color.new(cGreen, 85))
            line.new(bar_index, close, b2, close, color=color.new(cText, 10), width=1)
            line.new(bar_index, sl, b2, sl, color=cRed, width=1)
            line.new(bar_index, tp, b2, tp, color=cGreen, width=1)
            label.new(bar_index, sl, (upBreak ? "LONG" : "SHORT") + " @ " + str.tostring(close, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick) + "\n" + str.tostring(tpR) + "R  qty " + str.tostring(q), style=upBreak ? label.style_label_up : label.style_label_down, color=color.new(upBreak ? cGreen : cRed, 20), textcolor=color.white, size=size.tiny)
    else if showTrades
        label.new(bar_index, close, risk < minStop ? "SKIP: stop under " + str.tostring(minStop) : "SKIP: stop over " + str.tostring(maxStop), style=label.style_label_left, color=color.new(cMuted, 40), textcolor=color.white, size=size.tiny)

plotshape(longSig, "BUY", shape.triangleup, location.belowbar, cGreen, text="BUY", textcolor=cGreen, size=size.small)
plotshape(shortSig, "SELL", shape.triangledown, location.abovebar, cRed, text="SELL", textcolor=cRed, size=size.small)

// ---------- Exits: 2-hour time stop and the flat-by time
if strategy.position_size != 0 and strategy.opentrades > 0
    if time - strategy.opentrades.entry_time(0) >= maxHoldMin * 60000
        strategy.close_all(comment="TIME")
    else if nyHour >= flatHour
        strategy.close_all(comment="EOD")

// ---------- Closed trades: labels and QuantBot close messages
var int seen = 0
bool tpHit = false
bool slHit = false
bool timeHit = false
if strategy.closedtrades > seen
    for k = seen to strategy.closedtrades - 1
        string ex = strategy.closedtrades.exit_comment(k)
        float pnl = strategy.closedtrades.profit(k)
        float px = strategy.closedtrades.exit_price(k)
        string reason = ex == "TP" ? "tp" : ex == "SL" ? "sl" : ex == "TIME" ? "time" : ex == "EOD" ? "eod" : "signal"
        tpHit := tpHit or reason == "tp"
        slHit := slHit or reason == "sl"
        timeHit := timeHit or reason == "time" or reason == "eod"
        qbSend("close", px, na, na, na, reason, tradeId)
        lastEvent := str.upper(reason) + " " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#.##")
        if showTrades
            label.new(bar_index, px, str.upper(reason) + " " + (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#.##"), style=label.style_label_left, color=color.new(pnl >= 0 ? cGreen : cRed, 25), textcolor=color.white, size=size.tiny)
    seen := strategy.closedtrades

plotshape(tpHit, "TP", shape.circle, location.abovebar, cGreen, text="TP", textcolor=cGreen, size=size.tiny)
plotshape(slHit, "SL", shape.xcross, location.abovebar, cRed, text="SL", textcolor=cRed, size=size.tiny)
plotshape(timeHit, "CLOSE", shape.square, location.abovebar, cMuted, text="TIME", textcolor=cMuted, size=size.tiny)

// ---------- Draw on liquidity (a visual guide only: it does not change the backtested trades)
// Liquidity = where stops rest: previous day/week highs and lows, the Asia and London ranges, and untaken swing highs
// and lows (equal highs/lows marked). The 1-hour trend picks the side; the nearest untaken level on that side at least
// "Ignore targets closer than" away is the draw on liquidity. The line redraws on every new bar.
G_D = "Draw on liquidity"
showDol  = input.bool(true, "Show the draw-on-liquidity line", group=G_D)
dolHtf   = input.timeframe("60", "Bias timeframe", group=G_D)
pivLen   = input.int(5, "Swing size (bars each side)", minval=2, group=G_D)
eqTol    = input.float(0.6, "Equal highs/lows tolerance (price)", minval=0, step=0.1, group=G_D)
minDist  = input.float(3.0, "Ignore targets closer than (price)", minval=0, step=0.5, group=G_D)
asiaSess = input.session("2000-0000", "Asia range (New York time)", group=G_D)

[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
[hClose, hFast, hSlow] = request.security(syminfo.tickerid, dolHtf, [close[1], ta.ema(close, 50)[1], ta.ema(close, 200)[1]], lookahead=barmerge.lookahead_on)
dolBull = hClose > hFast and hFast > hSlow
dolBear = hClose < hFast and hFast < hSlow

// Today's and this week's high/low so far (a previous day/week level is taken once price trades through it)
var float dHi = na
var float dLo = na
if ta.change(time("D")) != 0
    dHi := high
    dLo := low
else
    dHi := math.max(nz(dHi, high), high)
    dLo := math.min(nz(dLo, low), low)
var float wHi = na
var float wLo = na
if ta.change(time("W")) != 0
    wHi := high
    wLo := low
else
    wHi := math.max(nz(wHi, high), high)
    wLo := math.min(nz(wLo, low), low)

// Asia range, and how far price has gone since it closed
inAsia = not na(time(timeframe.period, asiaSess, TZ))
var float aHi = na
var float aLo = na
var float aPostHi = na
var float aPostLo = na
if inAsia and not inAsia[1]
    aHi := high
    aLo := low
    aPostHi := na
    aPostLo := na
else if inAsia
    aHi := math.max(aHi, high)
    aLo := math.min(aLo, low)
else if not na(aHi)
    aPostHi := math.max(nz(aPostHi, high), high)
    aPostLo := math.min(nz(aPostLo, low), low)

// How far price has gone since the London range closed
var float lPostHi = na
var float lPostLo = na
if inRange
    lPostHi := na
    lPostLo := na
else if rReady
    lPostHi := math.max(nz(lPostHi, high), high)
    lPostLo := math.min(nz(lPostLo, low), low)

// Untaken swing highs and lows (newest 10 of each); two within the tolerance are equal highs / equal lows
var float[] swH = array.new_float()
var string[] swHn = array.new_string()
var float[] swL = array.new_float()
var string[] swLn = array.new_string()
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    string nm = "SWING HIGH"
    if array.size(swH) > 0
        for j = 0 to array.size(swH) - 1
            if math.abs(array.get(swH, j) - ph) <= eqTol
                nm := "EQUAL HIGHS"
                array.set(swHn, j, "EQUAL HIGHS")
    array.push(swH, ph)
    array.push(swHn, nm)
    if array.size(swH) > 10
        array.shift(swH)
        array.shift(swHn)
if not na(pl)
    string nm = "SWING LOW"
    if array.size(swL) > 0
        for j = 0 to array.size(swL) - 1
            if math.abs(array.get(swL, j) - pl) <= eqTol
                nm := "EQUAL LOWS"
                array.set(swLn, j, "EQUAL LOWS")
    array.push(swL, pl)
    array.push(swLn, nm)
    if array.size(swL) > 10
        array.shift(swL)
        array.shift(swLn)
// A swing level is taken (removed) once price trades through it
if array.size(swH) > 0
    for j = array.size(swH) - 1 to 0
        if high > array.get(swH, j)
            array.remove(swH, j)
            array.remove(swHn, j)
if array.size(swL) > 0
    for j = array.size(swL) - 1 to 0
        if low < array.get(swL, j)
            array.remove(swL, j)
            array.remove(swLn, j)

addLevel(float[] ps, string[] ns, float p, string n, bool ok) =>
    if ok and not na(p)
        array.push(ps, p)
        array.push(ns, n)

// The nearest two levels at least minDist from price, above (buy-side) or below (sell-side)
pick(float[] ps, string[] ns, bool above) =>
    float p1 = na
    string n1 = ""
    float p2 = na
    string n2 = ""
    if array.size(ps) > 0
        for j = 0 to array.size(ps) - 1
            float p = array.get(ps, j)
            float d = above ? p - close : close - p
            if d >= minDist
                if na(p1) or d < math.abs(p1 - close)
                    p2 := p1
                    n2 := n1
                    p1 := p
                    n1 := array.get(ns, j)
                else if na(p2) or d < math.abs(p2 - close)
                    p2 := p
                    n2 := array.get(ns, j)
    [p1, n1, p2, n2]

var line dolPath = na
var line dolLevel = na
var label dolLabel = na
var line dol2Level = na
var label dol2Label = na
var string dolText = "-"

if showDol and barstate.islast
    float[] hp = array.new_float()
    string[] hn = array.new_string()
    float[] lp = array.new_float()
    string[] ln = array.new_string()
    addLevel(hp, hn, pdh, "PREV DAY HIGH", dHi <= pdh)
    addLevel(lp, ln, pdl, "PREV DAY LOW", dLo >= pdl)
    addLevel(hp, hn, pwh, "PREV WEEK HIGH", wHi <= pwh)
    addLevel(lp, ln, pwl, "PREV WEEK LOW", wLo >= pwl)
    addLevel(hp, hn, aHi, "ASIA HIGH", not inAsia and (na(aPostHi) or aPostHi <= aHi))
    addLevel(lp, ln, aLo, "ASIA LOW", not inAsia and (na(aPostLo) or aPostLo >= aLo))
    addLevel(hp, hn, rHi, "LONDON HIGH", rReady and not inRange and (na(lPostHi) or lPostHi <= rHi))
    addLevel(lp, ln, rLo, "LONDON LOW", rReady and not inRange and (na(lPostLo) or lPostLo >= rLo))
    if array.size(swH) > 0
        for j = 0 to array.size(swH) - 1
            addLevel(hp, hn, array.get(swH, j), array.get(swHn, j), true)
    if array.size(swL) > 0
        for j = 0 to array.size(swL) - 1
            addLevel(lp, ln, array.get(swL, j), array.get(swLn, j), true)
    [up1, upN1, up2, upN2] = pick(hp, hn, true)
    [dn1, dnN1, dn2, dnN2] = pick(lp, ln, false)
    float t1 = na
    string n1 = ""
    float t2 = na
    string n2 = ""
    if dolBull
        t1 := up1
        n1 := upN1
        t2 := up2
        n2 := upN2
    else if dolBear
        t1 := dn1
        n1 := dnN1
        t2 := dn2
        n2 := dnN2
    else
        bool upNearer = not na(up1) and (na(dn1) or up1 - close <= close - dn1)
        t1 := upNearer ? up1 : dn1
        n1 := upNearer ? upN1 : dnN1
        t2 := upNearer ? dn1 : up1
        n2 := upNearer ? dnN1 : upN1
    line.delete(dolPath)
    line.delete(dolLevel)
    label.delete(dolLabel)
    line.delete(dol2Level)
    label.delete(dol2Label)
    string biasTxt = dolBull ? "bullish" : dolBear ? "bearish" : "neutral"
    if not na(t1)
        bool goingUp = t1 > close
        dolPath := line.new(bar_index, close, bar_index + 20, t1, color=cBlue, width=2, style=line.style_arrow_right)
        dolLevel := line.new(bar_index - 40, t1, bar_index + 40, t1, color=cBlue, width=1, style=line.style_dashed)
        dolLabel := label.new(bar_index + 20, t1, "DOL " + (goingUp ? "▲ " : "▼ ") + n1 + "  " + str.tostring(t1, format.mintick) + "  (" + (goingUp ? "+" : "") + str.tostring(t1 - close, format.mintick) + ")", style=label.style_label_left, color=color.new(cBlue, 15), textcolor=color.white, size=size.small)
        dolText := (goingUp ? "▲ " : "▼ ") + n1 + " " + str.tostring(t1, format.mintick) + " (" + biasTxt + ")"
        if not na(t2)
            dol2Level := line.new(bar_index - 40, t2, bar_index + 40, t2, color=color.new(cBlue, 55), width=1, style=line.style_dotted)
            dol2Label := label.new(bar_index + 40, t2, "DOL 2  " + n2 + "  " + str.tostring(t2, format.mintick), style=label.style_label_left, color=color.new(cBlue, 60), textcolor=color.white, size=size.tiny)
    else
        dolText := "no target in range (" + biasTxt + ")"

// ---------- Dashboard
var table panel = table.new(position.top_right, 2, 10, bgcolor=color.new(#111318, 10), border_color=color.new(#2a2d35, 0), border_width=1)
cell(int r, string k, string v, color vc) =>
    table.cell(panel, 0, r, k, text_color=cMuted, text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)

// Next opening of the entry window (New York time), skipping weekends
nextWindow() =>
    int eh = int(str.tonumber(str.substring(entrySess, 0, 2)))
    int em = int(str.tonumber(str.substring(entrySess, 2, 4)))
    int t = timestamp(TZ, year(timenow, TZ), month(timenow, TZ), dayofmonth(timenow, TZ), eh, em)
    if timenow >= t
        t += 86400000
    if dayofweek(t, TZ) == dayofweek.saturday
        t += 2 * 86400000
    else if dayofweek(t, TZ) == dayofweek.sunday
        t += 86400000
    t
countdown(int ms) =>
    int mins = int(math.max(0, ms) / 60000)
    str.tostring(int(mins / 60)) + "h " + str.tostring(mins % 60) + "m"

if showPanel and barstate.islast
    string nextIn = "next window " + str.substring(entrySess, 0, 2) + ":" + str.substring(entrySess, 2, 4) + " NY in " + countdown(nextWindow() - timenow)
    string status = strategy.position_size > 0 ? "In a long" : strategy.position_size < 0 ? "In a short" : inEntry and rReady and rDate == nyDate and not doneToday ? "Watching for a breakout" : inRange ? "Building London range, " + nextIn : doneToday and rDate == nyDate ? "Done for today, " + nextIn : "Waiting, " + nextIn
    float wr = strategy.closedtrades > 0 ? float(strategy.wintrades) / strategy.closedtrades * 100 : 0
    float pf = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0
    cell(0, "QB Gold London-NY", "", cText)
    cell(1, "Status", status, cAmber)
    cell(2, "London range", na(rHi) ? "-" : str.tostring(rLo, format.mintick) + " - " + str.tostring(rHi, format.mintick), cText)
    cell(3, "Trades", str.tostring(strategy.closedtrades), cText)
    cell(4, "Win rate", str.tostring(wr, "#.0") + "%", cText)
    cell(5, "Profit factor", str.tostring(pf, "#.00"), pf >= 1 ? cGreen : cRed)
    cell(6, "Net P&L", (strategy.netprofit >= 0 ? "+$" : "-$") + str.tostring(math.abs(strategy.netprofit), "#,###.##"), strategy.netprofit >= 0 ? cGreen : cRed)
    cell(7, "Max drawdown", "$" + str.tostring(strategy.max_drawdown, "#,###.##"), cRed)
    cell(8, "Last signal", lastEvent, cText)
    cell(9, "Draw on liquidity", showDol ? dolText : "off", cBlue)
