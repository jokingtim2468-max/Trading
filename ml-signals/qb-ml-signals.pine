// QB ML Signals (generated by ml_signals.py, trained on NQ opening drives to 2025). Signals only, no trading.
// BUY/SELL at the 09:30 New York 5-minute bar when the model's probability of +2R before -1R is >= the threshold.
//@version=6
indicator("QB ML Signals", overlay=true, max_labels_count=500, max_lines_count=500)
float riskUsd = input.float(100, "Risk per trade ($)")
float th = input.float(0.42, "Show signals with probability >=")
string tz = "America/New_York"
int m = hour(time, tz) * 60 + minute(time, tz)
float atr = ta.atr(14)
float atrmed = ta.median(atr, 100)
float e20 = ta.ema(close, 20)
float e50 = ta.ema(close, 50)
float e200 = ta.ema(close, 200)
float rsi = ta.rsi(close, 14)
var float onh = na
var float onl = na
var float c1555 = na
var float pcl = na
if m >= 18 * 60 and m[1] < 18 * 60
    onh := high, onl := low
else if m >= 18 * 60 or m < 570
    onh := math.max(nz(onh, high), high), onl := math.min(nz(onl, low), low)
if m == 955
    c1555 := close
if m == 570 and barstate.isconfirmed
    int s = close > open ? 1 : close < open ? -1 : 0
    pcl := c1555
    if s != 0 and atr[1] > 0
        float a = atr[1]
        float gap = open - nz(pcl, open)
        float body_atr = math.abs(close - open) / a
        float range_atr = (high - low) / a
        float vol_ratio = a / atrmed
        float gap_atr = math.abs(gap) / a
        float gap_with = math.sign(gap) == s ? 1.0 : 0.0
        float on_break = (s > 0 and close > onh[1]) or (s < 0 and close < onl[1]) ? 1.0 : 0.0
        float ema20_atr = s * (close - e20) / a
        float ema50_atr = s * (close - e50) / a
        float ema200_atr = s * (close - e200) / a
        float rsi_c = s * (rsi - 50) / 50
        float weekday_mon = dayofweek(time, tz) == dayofweek.monday ? 1.0 : 0.0
        float weekday_fri = dayofweek(time, tz) == dayofweek.friday ? 1.0 : 0.0
        float z = -0.764794 + (0.273571) * body_atr + (-0.154721) * range_atr + (0.108076) * vol_ratio + (0.009562) * gap_atr + (-0.226480) * gap_with + (-0.133267) * on_break + (-0.089084) * ema20_atr + (0.073311) * ema50_atr + (0.028879) * ema200_atr + (0.015313) * rsi_c + (0.170710) * weekday_mon + (-0.011295) * weekday_fri
        float p = 1 / (1 + math.exp(-z))
        float sl = close - s * a
        float tp = close + s * 2 * a
        int q = math.max(1, int(math.floor(riskUsd / (a * syminfo.pointvalue))))
        bool take = p >= th
        label.new(bar_index, s > 0 ? low - a * 0.4 : high + a * 0.4, (s > 0 ? "BUY " : "SELL ") + str.tostring(math.round(p * 100)) + "%\nSL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick) + "\n" + str.tostring(q) + " contracts", style=s > 0 ? label.style_label_up : label.style_label_down, color=color.new(s > 0 ? #22c55e : #ef4444, take ? 10 : 75), textcolor=color.white, size=size.small)
        if take
            line.new(bar_index, sl, bar_index + 40, sl, color=#ef4444, width=2)
            line.new(bar_index, tp, bar_index + 40, tp, color=#22c55e, width=2)
            alert((s > 0 ? "BUY " : "SELL ") + syminfo.ticker + " " + str.tostring(math.round(p * 100)) + "% SL " + str.tostring(sl, format.mintick) + " TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
